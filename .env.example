# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_S=30
AGENT_WORKERS=8        # customers decided in parallel (lower it if you see RATE_LIMITED failures)
# Telegram (create a bot with @BotFather, paste its token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_MODE=1   # 1: every simulated customer's offer goes to your test chat(s) (send /test to the bot); 0: only real customers who pressed Start
DELIVERY_MODE=dry_run  # live: really send; dry_run: only log what would be sent
